# Copy this file to .env on 714. Do not commit the copied file.
VOCALDIVE_OMR_DATA_ROOT=D:\\VocalDiveOMR\\data
VOCALDIVE_OMR_STATE_ROOT=D:\\VocalDiveOMR\\state
VOCALDIVE_OMR_TOKENS_FILE=D:\\VocalDiveOMR\\state\\tokens.json
# Public Cloudflare Tunnel address. The email link returns here after the user verifies.
VOCALDIVE_OMR_PUBLIC_BASE_URL=https://omr.vocaldive.com
# Restricted Resend sending key. Keep the value only in the copied .env on 714.
VOCALDIVE_OMR_RESEND_API_KEY=
VOCALDIVE_OMR_AUTH_FROM=VocalDive <access@auth.vocaldive.com>
VOCALDIVE_OMR_AUTH_REPLY_TO=support@vocaldive.com
# One-use email links last 24 hours by default. Existing links retain the lifetime issued to them.
VOCALDIVE_OMR_AUTH_LINK_TTL_HOURS=24
# Public-beta email-link limits. Failed Resend deliveries do not consume an allowance.
VOCALDIVE_OMR_EMAIL_REQUEST_WINDOW_SECONDS=900
VOCALDIVE_OMR_EMAIL_REQUEST_LIMIT=10
VOCALDIVE_OMR_IP_REQUEST_LIMIT=40
# CRM/account data is separate from the queue metadata and raw dated job folders.
VOCALDIVE_OMR_CRM_DATABASE=D:\\VocalDiveOMR\\state\\crm.sqlite3
# Google Drive backup uses rclone. It copies only CRM snapshots and audit manifests.
VOCALDIVE_OMR_GOOGLE_DRIVE_REMOTE=
VOCALDIVE_OMR_RCLONE_CONFIG=D:\\VocalDiveOMR\\state\\rclone.conf
# Leave as `oemer` to use the CLI installed beside this worker's Python. An absolute path is an advanced override.
VOCALDIVE_OMR_EXECUTABLE=oemer
VOCALDIVE_OMR_GPU_BUSY_PERCENT=35
VOCALDIVE_OMR_GPU_BUSY_VRAM_PERCENT=30
VOCALDIVE_OMR_HOST=127.0.0.1
VOCALDIVE_OMR_PORT=8787
